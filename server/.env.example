# Copy to .env and fill in real values.

# Server
PORT=3000
NODE_ENV=development

# Public site URL (used for Yoco redirects and post-OAuth redirect)
SITE_URL=http://localhost:5173

# JWT signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# MySQL access is done via a PHP bridge file (see php-bridge/api.php)
PHP_BRIDGE_URL=http://localhost/repo-shop/php-bridge/api.php
BRIDGE_KEY=change-me-bridge-key

# Yoco (South African payments)
YOCO_SECRET_KEY=sk_test_xxx
YOCO_WEBHOOK_SECRET=whsec_xxx
PRICE_CENTS=49900

# Path to the git repo that gets zipped on download
REPO_PATH=C:/Users/User/Desktop/RepoShop

# --- OAuth (Google only) ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {OAUTH_CALLBACK_BASE}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL Google's callback is registered at (no trailing slash).
OAUTH_CALLBACK_BASE=http://localhost:3000